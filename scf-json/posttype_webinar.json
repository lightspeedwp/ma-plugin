      "label": "Webinar URL",
      "description": "Link to webinar platform (Zoom, Teams, etc.)",
      "required": false,
      "placeholder": ""
    },
    {
      "slug": "ma_plugin_replay_url",
      "type": "url",
      "label": "Replay URL",
      "description": "Link to recorded webinar",
      "required": false,
      "placeholder": ""
    },
    {
      "slug": "ma_plugin_duration_minutes",
      "type": "number",
      "label": "Duration (Minutes)",
      "description": "Webinar duration in minutes",
      "required": false,
      "placeholder": ""
    },
    {
      "slug": "ma_plugin_cpd_points",
      "type": "number",
      "label": "CPD Points",
      "description": "",
      "required": false,
      "placeholder": "",
      "default_value": 0,
      "min": 0,
      "max": 10
    },
    {
      "slug": "ma_plugin_presenters",
      "type": "repeater",
