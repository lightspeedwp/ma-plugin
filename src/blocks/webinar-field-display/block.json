{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ma-plugin/webinar-field-display",
	"version": "1.0.0",
	"title": "Webinar/Event Field Display",
	"category": "ma-plugin",
	"icon": "admin-post",
	"description": "Display a custom field value from Webinar/Event post type with optional prefix.",
	"keywords": [
		"field",
		"meta",
		"custom",
		"webinar"
	],
	"textdomain": "ma-plugin",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./index.css",
	"render": "ma_plugin_render_webinar_field_display",
	"supports": {
		"html": false,
		"align": true,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"attributes": {
		"fieldKey": {
			"type": "string",
			"default": ""
		},
		"prefix": {
			"type": "string",
			"default": ""
		},
		"prefixBold": {
			"type": "boolean",
			"default": false
		},
		"fallbackText": {
			"type": "string",
			"default": ""
		}
	},
	"usesContext": [
		"postId",
		"postType"
	],
	"example": {
		"attributes": {
			"fieldKey": "example_field",
			"prefix": "Label:",
			"prefixBold": true
		}
	}
}
